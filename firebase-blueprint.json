{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "An expense entry representing a shared cohabitation cost or payment ledger item.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "A brief description/title of the expense."
        },
        "amount": {
          "type": "number",
          "description": "The total Euro amount of the expense."
        },
        "paidBy": {
          "type": "string",
          "enum": ["Ozric", "Pawan"],
          "description": "The roommate who initially paid for the expense."
        },
        "splitType": {
          "type": "string",
          "enum": ["50/50", "custom", "itemized"],
          "description": "How the cost is divided between roommates."
        },
        "category": {
          "type": "string",
          "enum": [
            "Shared Groceries",
            "Household Supplies",
            "Rent",
            "Electricity (Coins)",
            "Internet/Wi-Fi",
            "Takeout/Delivery",
            "Other"
          ],
          "description": "The expense category classification."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server-generated timestamp when the expense was logged."
        },
        "splitDetails": {
          "type": "object",
          "properties": {
            "OzricAmount": {
              "type": "number"
            },
            "PawanAmount": {
              "type": "number"
            }
          },
          "required": ["OzricAmount", "PawanAmount"]
        },
        "isCoin": {
          "type": "boolean",
          "description": "Whether this log is for physical electricity meter coin insertion."
        },
        "isSettlement": {
          "type": "boolean",
          "description": "Whether this is a settle-up balance transfer entry."
        },
        "isLendBorrow": {
          "type": "boolean",
          "description": "Whether this is a lend/borrow direct cash or transfer entry."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash", "Revolut", "Bank Transfer"],
          "description": "The transfer mode used for the lend/borrow transaction."
        },
        "itemizedDetails": {
          "type": "object",
          "properties": {
            "personalUser": {
              "type": "string",
              "enum": ["Ozric", "Pawan"]
            },
            "personalAmount": {
              "type": "number"
            }
          },
          "required": ["personalUser", "personalAmount"]
        },
        "notes": {
          "type": "string",
          "description": "Optional custom notes or comments."
        }
      },
      "required": ["title", "amount", "paidBy", "splitType", "category", "splitDetails"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Roommate security profile storing encrypted or hashed password and custom preferences.",
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "description": "The password used to access and secure this profile."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "nickname": {
          "type": "string"
        }
      },
      "required": ["password"]
    },
    "PersonalAccount": {
      "title": "PersonalAccount",
      "description": "Private financial account belonging to a roommate in their private vault.",
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "enum": ["Ozric", "Pawan"]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["Cash", "Bank Account", "Revolut", "Digital Wallet"]
        },
        "balance": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["EUR", "NPR", "USD"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["user", "name", "type", "balance", "currency"]
    },
    "PersonalTransaction": {
      "title": "PersonalTransaction",
      "description": "Private financial transaction logged in a roommate's private vault.",
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "enum": ["Ozric", "Pawan"]
        },
        "title": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income", "remittance"]
        },
        "category": {
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "receiptUrl": {
          "type": "string"
        },
        "receiptName": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "enum": ["EUR", "NPR", "USD"]
        },
        "exchangeRate": {
          "type": "number"
        }
      },
      "required": ["user", "title", "amount", "type", "category", "accountId", "currency"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Private personal savings goals tracked in a roommate's private vault.",
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "enum": ["Ozric", "Pawan"]
        },
        "name": {
          "type": "string"
        },
        "targetAmount": {
          "type": "number"
        },
        "currentAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["EUR", "NPR", "USD"]
        },
        "deadline": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["user", "name", "targetAmount", "currentAmount", "currency", "deadline"]
    },
    "RecurringBill": {
      "title": "RecurringBill",
      "description": "Private recurring bills tracked in a roommate's private vault.",
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "enum": ["Ozric", "Pawan"]
        },
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "dueDate": {
          "type": "integer"
        },
        "frequency": {
          "type": "string",
          "enum": ["Monthly", "Weekly", "Yearly"]
        },
        "currency": {
          "type": "string",
          "enum": ["EUR", "NPR", "USD"]
        },
        "lastPaid": {
          "type": "string"
        },
        "reminderActive": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["user", "name", "amount", "category", "dueDate", "frequency", "currency", "reminderActive"]
    },
    "DiscordSettings": {
      "title": "DiscordSettings",
      "description": "Discord push notification configurations and routing webhooks.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webhookUrl": {
          "type": "string"
        },
        "customPrefix": {
          "type": "string"
        },
        "messageFormat": {
          "type": "string",
          "enum": ["embed", "text"]
        }
      },
      "required": ["enabled", "webhookUrl", "messageFormat", "customPrefix"]
    }
  },
  "firestore": {
    "discord_settings": {
      "schema": {
        "$ref": "#/entities/DiscordSettings"
      },
      "description": "Configuration document for sending Discord push notifications."
    },
    "expenses": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "The primary collection storing all ledger items, electricity coin logs, and settlements."
    },
    "profiles": {
      "schema": {
        "$ref": "#/entities/Profile"
      },
      "description": "Security profiles for Ozric and Pawan."
    },
    "personal_accounts": {
      "schema": {
        "$ref": "#/entities/PersonalAccount"
      },
      "description": "Vault accounts storing personal balances for each roommate."
    },
    "personal_transactions": {
      "schema": {
        "$ref": "#/entities/PersonalTransaction"
      },
      "description": "Vault transactions storing history for each roommate's personal spending."
    },
    "personal_savings_goals": {
      "schema": {
        "$ref": "#/entities/SavingsGoal"
      },
      "description": "Vault savings goals tracked by each roommate."
    },
    "personal_recurring_bills": {
      "schema": {
        "$ref": "#/entities/RecurringBill"
      },
      "description": "Vault recurring subscription bills tracked by each roommate."
    }
  }
}
