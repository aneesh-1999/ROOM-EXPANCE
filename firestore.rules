rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared roommate expenses collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Work shifts and roster entries
    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    // Roommate security profiles
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Personal Accounts
    match /personal_accounts/{accountId} {
      allow read, write: if true;
    }

    // Personal Transactions
    match /personal_transactions/{transactionId} {
      allow read, write: if true;
    }

    // Personal Savings Goals
    match /personal_savings_goals/{goalId} {
      allow read, write: if true;
    }

    // Personal Recurring Bills
    match /personal_recurring_bills/{billId} {
      allow read, write: if true;
    }

    // Discord Settings
    match /discord_settings/{settingsId} {
      allow read, write: if true;
    }

    // Login Activity Logs
    match /login_logs/{logId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
